{
  "$id": "https://zmuxuny.github.io/hy3-learning-agent/evaluation/schemas/case-suite-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "case-suite-manifest-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "case_files": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Case Files",
      "type": "array"
    },
    "resource_snapshot_file": {
      "title": "Resource Snapshot File",
      "type": "string"
    },
    "default_model_mode": {
      "enum": [
        "stub",
        "real"
      ],
      "title": "Default Model Mode",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "case_files",
    "resource_snapshot_file",
    "default_model_mode",
    "manifest_sha256"
  ],
  "title": "CaseSuiteManifestV1",
  "type": "object"
}
