    "ActionMeaningV2": {
      "additionalProperties": false,
      "properties": {
        "allowed_fields": {
          "items": {
            "const": "action_classes",
            "type": "string"
          },
          "title": "Allowed Fields",
          "type": "array"
        },
        "boundary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "combinable_with": {
          "items": {
            "enum": [
              "PROPOSE_PLAN",
              "REQUEST_USER_INPUT",
              "WAIT",
              "INTERVENE_MESSAGE",
              "INTERVENE_QUIZ_OR_REVIEW",
              "PROPOSE_PLAN_ADJUSTMENT",
              "ACCEPT",
              "REVISION_REQUIRED",
              "INSUFFICIENT_EVIDENCE",
              "REQUEST_CLARIFICATION",
              "NO_OP",
              "PROPOSE_CHANGE",
              "APPLY_REVERSIBLE_PATCH",
              "REQUEST_APPROVAL"
            ],
            "type": "string"
          },
          "title": "Combinable With",
          "type": "array"
        },
        "decision_semantics": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Decision Semantics",
          "type": "string"
        },
        "forbidden_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "title": "Forbidden Fields",
          "type": "array"
        },
        "missing_declaration_policy": {
          "const": "record_as_scoreable_behavior_failure",
          "title": "Missing Declaration Policy",
          "type": "string"
        },
        "negative_example": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Negative Example",
          "type": "string"
        },
        "positive_example": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Positive Example",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "const": "action_classes",
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "track": {
          "enum": [
            "planning",
            "intervention",
            "assessment",
            "revision",
            "planning_or_intervention"
          ],
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "track",
        "decision_semantics",
        "required_fields",
        "allowed_fields",
        "forbidden_fields",
        "boundary",
        "positive_example",
        "negative_example",
        "combinable_with",
        "missing_declaration_policy"
      ],
      "title": "ActionMeaningV2",
      "type": "object"
    }
