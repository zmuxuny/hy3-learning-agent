{
  "$id": "https://zmuxuny.github.io/hy3-learning-agent/evaluation/schemas/aggregate-track-result-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregator_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Aggregator Implementation Sha256",
      "type": "string"
    },
    "aggregator_implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Aggregator Implementation Version",
      "type": "string"
    },
    "aggregator_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Aggregator Version",
      "type": "string"
    },
    "complete_episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Complete Episode Ids",
      "type": "array"
    },
    "episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Episode Ids",
      "type": "array"
    },
    "evaluation_status": {
      "enum": [
        "not_a_formal_model_evaluation",
        "formal_model_evaluation"
      ],
      "title": "Evaluation Status",
      "type": "string"
    },
    "failed_episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Failed Episode Ids",
      "type": "array"
    },
    "formal_evaluation_result": {
      "title": "Formal Evaluation Result",
      "type": "boolean"
    },
    "input_judge_manifest_formal_evaluation_result": {
      "title": "Input Judge Manifest Formal Evaluation Result",
      "type": "boolean"
    },
    "invalid_input_episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Invalid Input Episode Ids",
      "type": "array"
    },
    "judge_error_episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Judge Error Episode Ids",
      "type": "array"
    },
    "mean_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mean Score"
    },
    "result_formal_evaluation_states": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Result Formal Evaluation States",
      "type": "object"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "runtime_failure_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Runtime Failure Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "aggregate-track-result-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "score_count": {
      "minimum": 0,
      "title": "Score Count",
      "type": "integer"
    },
    "selection_mode": {
      "enum": [
        "inherited",
        "adhoc_filter"
      ],
      "title": "Selection Mode",
      "type": "string"
    },
    "track": {
      "enum": [
        "planning",
        "intervention",
        "assessment",
        "revision"
      ],
      "title": "Track",
      "type": "string"
    },
    "worktree_clean": {
      "title": "Worktree Clean",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "aggregator_version",
    "aggregator_implementation_version",
    "aggregator_implementation_sha256",
    "track",
    "episode_ids",
    "complete_episode_ids",
    "failed_episode_ids",
    "invalid_input_episode_ids",
    "judge_error_episode_ids",
    "runtime_failure_ids",
    "score_count",
    "mean_score",
    "input_judge_manifest_formal_evaluation_result",
    "result_formal_evaluation_states",
    "selection_mode",
    "worktree_clean",
    "formal_evaluation_result",
    "evaluation_status",
    "result_sha256"
  ],
  "title": "AggregateTrackResultV3",
  "type": "object"
}
