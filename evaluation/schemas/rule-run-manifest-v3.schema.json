{
  "$id": "https://zmuxuny.github.io/hy3-learning-agent/evaluation/schemas/rule-run-manifest-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Episode Ids",
      "type": "array"
    },
    "evaluator_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Implementation Sha256",
      "type": "string"
    },
    "evaluator_implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Evaluator Implementation Version",
      "type": "string"
    },
    "evaluator_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Evaluator Version",
      "type": "string"
    },
    "formal_evaluation_result": {
      "title": "Formal Evaluation Result",
      "type": "boolean"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "input_episode_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Episode Digests",
      "type": "object"
    },
    "input_episode_schema_version": {
      "const": "decision-episode-v4",
      "title": "Input Episode Schema Version",
      "type": "string"
    },
    "input_failure_schema_version": {
      "const": "runtime-failure-v2",
      "title": "Input Failure Schema Version",
      "type": "string"
    },
    "input_reference_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Reference Digests",
      "type": "object"
    },
    "input_reference_schema_version": {
      "const": "judge-reference-v2",
      "title": "Input Reference Schema Version",
      "type": "string"
    },
    "input_runtime_failure_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Runtime Failure Digests",
      "type": "object"
    },
    "input_runtime_formal_evaluation_result": {
      "title": "Input Runtime Formal Evaluation Result",
      "type": "boolean"
    },
    "input_runtime_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Runtime Manifest Sha256",
      "type": "string"
    },
    "invocation_mode": {
      "enum": [
        "stub",
        "real"
      ],
      "title": "Invocation Mode",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "requested_episode_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Requested Episode Ids",
      "type": "array"
    },
    "result_formal_evaluation_states": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Result Formal Evaluation States",
      "type": "object"
    },
    "rule_pack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rule Pack Sha256",
      "type": "string"
    },
    "rule_pack_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Rule Pack Version",
      "type": "string"
    },
    "rule_result_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rule Result Digests",
      "type": "object"
    },
    "runtime_failure_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Runtime Failure Ids",
      "type": "array"
    },
    "runtime_failure_tracks": {
      "additionalProperties": {
        "enum": [
          "planning",
          "intervention",
          "assessment",
          "revision"
        ],
        "type": "string"
      },
      "title": "Runtime Failure Tracks",
      "type": "object"
    },
    "schema_version": {
      "const": "rule-run-manifest-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_track": {
      "anyOf": [
        {
          "enum": [
            "planning",
            "intervention",
            "assessment",
            "revision"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Track"
    },
    "selection_mode": {
      "enum": [
        "inherited",
        "adhoc_filter"
      ],
      "title": "Selection Mode",
      "type": "string"
    },
    "worktree_clean": {
      "title": "Worktree Clean",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "input_episode_schema_version",
    "input_reference_schema_version",
    "input_failure_schema_version",
    "evaluator_version",
    "evaluator_implementation_version",
    "evaluator_implementation_sha256",
    "rule_pack_version",
    "rule_pack_sha256",
    "input_runtime_manifest_sha256",
    "input_runtime_formal_evaluation_result",
    "invocation_mode",
    "selection_mode",
    "requested_episode_ids",
    "selected_track",
    "episode_ids",
    "runtime_failure_ids",
    "input_episode_digests",
    "input_reference_digests",
    "input_runtime_failure_digests",
    "runtime_failure_tracks",
    "rule_result_digests",
    "result_formal_evaluation_states",
    "formal_evaluation_result",
    "worktree_clean",
    "git_commit",
    "manifest_sha256"
  ],
  "title": "RuleRunManifestV3",
  "type": "object"
}
