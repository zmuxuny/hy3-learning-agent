{
  "$defs": {
    "AggregateDimensionV1": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6",
            "D7"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "level": {
          "enum": [
            0,
            1,
            2
          ],
          "title": "Level",
          "type": "integer"
        },
        "weight": {
          "enum": [
            5,
            10,
            15,
            20
          ],
          "title": "Weight",
          "type": "integer"
        },
        "weighted_signal": {
          "maximum": 20,
          "minimum": 0,
          "title": "Weighted Signal",
          "type": "number"
        },
        "evidence_paths": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?(?:\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Paths",
          "type": "array"
        }
      },
      "required": [
        "dimension_id",
        "level",
        "weight",
        "weighted_signal",
        "evidence_paths"
      ],
      "title": "AggregateDimensionV1",
      "type": "object"
    },
    "AggregateRuleFailureV1": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Check Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?(?:\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?)*$",
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "severity",
        "reason_code",
        "evidence_paths"
      ],
      "title": "AggregateRuleFailureV1",
      "type": "object"
    },
    "AppliedScoreCapV1": {
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "enum": [
            "critical_hard_gate",
            "major_rule_fail"
          ],
          "title": "Cap Id",
          "type": "string"
        },
        "maximum_score": {
          "enum": [
            39,
            69
          ],
          "title": "Maximum Score",
          "type": "integer"
        },
        "source_rule_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "cap_id",
        "maximum_score",
        "source_rule_ids"
      ],
      "title": "AppliedScoreCapV1",
      "type": "object"
    },
    "SuggestedHardGateV1": {
      "additionalProperties": false,
      "properties": {
        "suggestion_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?(?:\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\[(?:0|[1-9]\\d*)\\])?)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Paths",
          "type": "array"
        },
        "public_summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Public Summary",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "reason_code",
        "evidence_paths",
        "public_summary"
      ],
      "title": "SuggestedHardGateV1",
      "type": "object"
    }
  },
  "$id": "https://zmuxuny.github.io/hy3-learning-agent/evaluation/schemas/aggregate-result-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "aggregate-result-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "aggregator_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Aggregator Version",
      "type": "string"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Episode Id",
      "type": "string"
    },
    "track": {
      "enum": [
        "planning",
        "intervention",
        "assessment",
        "revision"
      ],
      "title": "Track",
      "type": "string"
    },
    "episode_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Episode Sha256",
      "type": "string"
    },
    "rule_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rule Result Sha256",
      "type": "string"
    },
    "judge_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Result Sha256",
      "type": "string"
    },
    "judge_reference_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Reference Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "invalid_input",
        "judge_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/AggregateDimensionV1"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "raw_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Score"
    },
    "rule_failures": {
      "items": {
        "$ref": "#/$defs/AggregateRuleFailureV1"
      },
      "title": "Rule Failures",
      "type": "array"
    },
    "actual_hard_gates": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "title": "Actual Hard Gates",
      "type": "array"
    },
    "judge_suggested_hard_gates": {
      "items": {
        "$ref": "#/$defs/SuggestedHardGateV1"
      },
      "title": "Judge Suggested Hard Gates",
      "type": "array"
    },
    "applied_caps": {
      "items": {
        "$ref": "#/$defs/AppliedScoreCapV1"
      },
      "title": "Applied Caps",
      "type": "array"
    },
    "final_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final Score"
    },
    "episode_outcome": {
      "enum": [
        "pass",
        "fail",
        "invalid_input",
        "judge_error"
      ],
      "title": "Episode Outcome",
      "type": "string"
    },
    "formal_evaluation_result": {
      "title": "Formal Evaluation Result",
      "type": "boolean"
    },
    "evaluation_status": {
      "enum": [
        "not_a_formal_model_evaluation",
        "formal_model_evaluation"
      ],
      "title": "Evaluation Status",
      "type": "string"
    },
    "invalid_reason_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invalid Reason Code"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "aggregator_version",
    "episode_id",
    "track",
    "episode_sha256",
    "rule_result_sha256",
    "judge_result_sha256",
    "judge_reference_sha256",
    "status",
    "dimensions",
    "raw_score",
    "rule_failures",
    "actual_hard_gates",
    "judge_suggested_hard_gates",
    "applied_caps",
    "final_score",
    "episode_outcome",
    "formal_evaluation_result",
    "evaluation_status",
    "invalid_reason_code",
    "result_sha256"
  ],
  "title": "AggregateResultV2",
  "type": "object"
}
