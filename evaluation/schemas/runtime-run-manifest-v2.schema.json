{
  "$defs": {
    "RuntimeTerminalRecordV2": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "case_spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Spec Sha256",
          "type": "string"
        },
        "track": {
          "enum": [
            "planning",
            "intervention",
            "assessment",
            "revision"
          ],
          "title": "Track",
          "type": "string"
        },
        "terminal_kind": {
          "enum": [
            "episode",
            "failure"
          ],
          "title": "Terminal Kind",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_spec_sha256",
        "track",
        "terminal_kind",
        "artifact_id",
        "artifact_sha256"
      ],
      "title": "RuntimeTerminalRecordV2",
      "type": "object"
    }
  },
  "$id": "https://zmuxuny.github.io/hy3-learning-agent/evaluation/schemas/runtime-run-manifest-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "runtime-run-manifest-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "case_schema_version": {
      "const": "case-spec-v1",
      "title": "Case Schema Version",
      "type": "string"
    },
    "episode_schema_version": {
      "const": "decision-episode-v3",
      "title": "Episode Schema Version",
      "type": "string"
    },
    "failure_schema_version": {
      "const": "runtime-failure-v1",
      "title": "Failure Schema Version",
      "type": "string"
    },
    "invocation_mode": {
      "enum": [
        "stub",
        "real"
      ],
      "title": "Invocation Mode",
      "type": "string"
    },
    "selected_case_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Case Ids",
      "type": "array"
    },
    "terminals": {
      "items": {
        "$ref": "#/$defs/RuntimeTerminalRecordV2"
      },
      "minItems": 1,
      "title": "Terminals",
      "type": "array"
    },
    "formal_evaluation_result": {
      "title": "Formal Evaluation Result",
      "type": "boolean"
    },
    "evaluation_status": {
      "enum": [
        "not_a_formal_model_evaluation",
        "formal_model_evaluation"
      ],
      "title": "Evaluation Status",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "dependency_lock_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "title": "Dependency Lock Version",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "case_schema_version",
    "episode_schema_version",
    "failure_schema_version",
    "invocation_mode",
    "selected_case_ids",
    "terminals",
    "formal_evaluation_result",
    "evaluation_status",
    "git_commit",
    "dependency_lock_version",
    "dependency_lock_sha256",
    "manifest_sha256"
  ],
  "title": "RuntimeRunManifestV2",
  "type": "object"
}
