# Tencent TokenHub / OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_API_BASE=https://tokenhub.tencentmaas.com/v1
MODEL_NAME=hy3
MODEL_CONTEXT_WINDOW=128000
MODEL_TEMPERATURE=0.9
MODEL_REASONING_EFFORT=high

# Local development database
DATABASE_URL=sqlite+aiosqlite:///./data/learning_companion.db

# Deployment boundary. Local mode accepts only loopback. Server mode requires
# an exact HTTPS public origin and a strong bearer token; see SECURITY.md.
DEPLOYMENT_MODE=local
SERVER_AUTH_TOKEN=
SERVER_PUBLIC_ORIGIN=
SERVER_SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proactive Agent
ENABLE_SCHEDULER=true
AGENT_HEARTBEAT_SECONDS=300
# When an active plan has no learning evidence for this long, the heartbeat may ask for progress.
AGENT_PROGRESS_CHECKIN_HOURS=24
AGENT_CANDIDATE_COOLDOWN_MINUTES=180
AGENT_DAILY_NOTIFICATION_LIMIT=3
AGENT_NOTIFICATION_COOLDOWN_MINUTES=180
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_RECENT_MESSAGE_LIMIT=16
AGENT_SESSION_COMPRESSION_THRESHOLD=24

# Hybrid memory retrieval (local_hash = offline BM25 + SimHash, zero extra dependencies)
MEMORY_RETRIEVAL_PROVIDER=local_hash

# Run budgets (0 disables the cost limit; token prices are used only for estimates)
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=32
AGENT_MAX_ELAPSED_SECONDS=600
AGENT_MAX_ESTIMATED_COST_USD=0
MODEL_INPUT_PRICE_PER_1M=0
MODEL_OUTPUT_PRICE_PER_1M=0

# Optional SMTP email delivery. Setup and connection tests: docs/EMAIL.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional IMAP replies. Use the same mailbox when your provider supports it.
ENABLE_EMAIL_REPLY_POLLING=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional Web Push (VAPID keys). Without these, browser notifications still
# work while the page is open; with them, notifications can be shown after the
# tab is closed while the browser is still running.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:learner@example.com

# Tool safety budgets
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_MODEL_RETRY_ATTEMPTS=2
AGENT_TOOL_TIMEOUT_SECONDS=35
AGENT_TOOL_MESSAGE_CHAR_LIMIT=16000
AGENT_SESSION_TITLE_TIMEOUT_SECONDS=15
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_FALLBACK_PROVIDER=bing
WEB_MAX_REDIRECTS=5
WEB_MAX_WIRE_BYTES=2000000
WEB_MAX_DECODED_BYTES=4000000
WEB_TOTAL_DEADLINE_SECONDS=20
TOOL_EXECUTION_TIMEOUT_SECONDS=10
TOOL_OUTPUT_LIMIT=12000
# No sandbox provider ships with this revision, so code_execute remains off.
CODE_SANDBOX_PROVIDER=none
