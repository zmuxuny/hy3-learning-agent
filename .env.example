# Tencent TokenHub / OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_API_BASE=https://tokenhub.tencentmaas.com/v1
MODEL_NAME=hy3
MODEL_TEMPERATURE=0.9
MODEL_REASONING_EFFORT=high

# Local development database
DATABASE_URL=sqlite+aiosqlite:///./data/learning_companion.db

# Proactive Agent
ENABLE_SCHEDULER=true
AGENT_HEARTBEAT_SECONDS=300
AGENT_DAILY_NOTIFICATION_LIMIT=3
AGENT_NOTIFICATION_COOLDOWN_MINUTES=180
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_RECENT_MESSAGE_LIMIT=16
AGENT_SESSION_COMPRESSION_THRESHOLD=24

# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Optional IMAP replies. Use the same mailbox when your provider supports it.
ENABLE_EMAIL_REPLY_POLLING=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Tool safety budgets
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_MODEL_RETRY_ATTEMPTS=2
AGENT_TOOL_TIMEOUT_SECONDS=35
AGENT_TOOL_MESSAGE_CHAR_LIMIT=16000
AGENT_SESSION_TITLE_TIMEOUT_SECONDS=15
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_PROVIDER=duckduckgo
WEB_MAX_REDIRECTS=5
WEB_ALLOW_SYNTHETIC_DNS=true
TOOL_EXECUTION_TIMEOUT_SECONDS=10
TOOL_OUTPUT_LIMIT=12000
